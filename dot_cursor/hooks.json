{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "python3 ./hooks/lint-working-tree.py",
        "timeout": 60,
        "loop_limit": 3,
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 ./hooks/deny-dangerous-shell.py",
        "failClosed": true,
        "timeout": 5
      },
      {
        "command": "python3 ./hooks/lint-staged-files.py",
        "failClosed": true,
        "timeout": 30
      },
      {
        "command": "python3 ./hooks/lint-commit-message.py",
        "failClosed": true,
        "timeout": 30
      }
    ]
  }
}
